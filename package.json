{
  "name": "typecsf",
  "private": true,
  "version": "3.0.0",
  "description": "TypeCSF - learn Computer Science while you learn to type. React + Tailwind CSS, English / Dari / Pashto.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "build:local": "node scripts/build-local.mjs",
    "test": "node --test tests/unit.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "test:all": "npm test && npm run build:local && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=20"
  }
}
