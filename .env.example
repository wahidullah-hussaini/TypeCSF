# Copy this file to ".env" and fill the values. Never commit ".env".
#
# Everything starting with VITE_ is compiled into the public JavaScript that
# every visitor can read. Only put values here that are SAFE TO BE PUBLIC.
# The EmailJS service id, template id and PUBLIC key are designed to be public.
# NEVER put an EmailJS *private* key or any password here.

# --- EmailJS (suggestion form) -------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Developer contact (public) ------------------------------------------
# Shown on the site. The e-mail RECIPIENT of suggestions is NOT read from here:
# it is fixed inside your EmailJS template (see README, "Email setup").
VITE_CONTACT_EMAIL=wahidullahhussaini1383@gmail.com
# International format, digits only, no plus sign or spaces.
VITE_WHATSAPP_NUMBER=93796883671
